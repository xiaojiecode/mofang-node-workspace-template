{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "useDefineForClassFields": true,
        "noEmit": true,
        "skipLibCheck": false,
        "types": [],
        "paths": {
            "@mofang/node": ["./lib/author/index.ts"],
            "@mofang/browser": ["./lib/browser/index.ts"],
            "@mofang/contracts/*": ["./lib/contracts/src/*"]
        }
    }
}
