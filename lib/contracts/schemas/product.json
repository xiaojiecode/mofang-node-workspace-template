{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mofang:workflow:type:product:1",
  "type": "object",
  "properties": {
    "collection": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "$ref": "urn:mofang:workflow:type:url:1"
        },
        "sourceItemId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "sourceUrl"
      ]
    },
    "basic": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "categoryPath": {
          "type": "string"
        },
        "price": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "urn:mofang:workflow:type:image:1"
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "$ref": "urn:mofang:workflow:type:video:1"
      }
    },
    "skus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skuCode": {
            "type": "string"
          },
          "skuName": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "image": {
            "$ref": "urn:mofang:workflow:type:image:1"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "specValues": {
            "type": "array",
            "items": {
              "type": "object",
              "title": "ProductAttribute",
              "properties": {
                "attributeId": {
                  "type": "string"
                },
                "canonicalKey": {
                  "type": "string"
                },
                "attributeName": {
                  "type": "string"
                },
                "sourceName": {
                  "type": "string"
                },
                "valueId": {
                  "type": "string"
                },
                "valueName": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "attributeName",
                "valueName"
              ],
              "additionalProperties": false
            }
          },
          "costPrice": {
            "type": "number",
            "minimum": 0
          },
          "sourcePrice": {
            "type": "number",
            "minimum": 0
          },
          "compareAtPrice": {
            "type": "number",
            "minimum": 0
          },
          "sourceCurrency": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "object",
            "title": "ProductWeight",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "enum": [
                  "kg",
                  "g",
                  "lb",
                  "oz"
                ]
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false
          },
          "presaleType": {
            "enum": [
              "none",
              "spot",
              "preorder"
            ]
          },
          "productionDays": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "required": [
                    "costPrice"
                  ]
                },
                {
                  "required": [
                    "sourcePrice"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "sourceCurrency"
              ]
            }
          }
        ]
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true
    },
    "references": {
      "type": "object",
      "properties": {
        "collectProductId": {
          "type": "string"
        },
        "draftProductId": {
          "type": "string"
        },
        "shopProductId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "productAttributes": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "ProductAttribute",
        "properties": {
          "attributeId": {
            "type": "string"
          },
          "canonicalKey": {
            "type": "string"
          },
          "attributeName": {
            "type": "string"
          },
          "sourceName": {
            "type": "string"
          },
          "valueId": {
            "type": "string"
          },
          "valueName": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "attributeName",
          "valueName"
        ],
        "additionalProperties": false
      }
    },
    "packageWeight": {
      "type": "object",
      "title": "ProductWeight",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "kg",
            "g",
            "lb",
            "oz"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "packageDimensions": {
      "type": "object",
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "cm",
            "mm",
            "m",
            "in"
          ]
        }
      },
      "required": [
        "length",
        "width",
        "height",
        "unit"
      ],
      "additionalProperties": false
    },
    "sizeChart": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "image",
            "template"
          ]
        },
        "imageUrl": {
          "$ref": "urn:mofang:workflow:type:url:1"
        },
        "template": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "image"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "template"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "template"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "imageUrl"
              ]
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "minProperties": 1,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "basic"
            ],
            "properties": {
              "basic": {
                "required": [
                  "price"
                ]
              }
            }
          },
          {
            "required": [
              "skus"
            ],
            "properties": {
              "skus": {
                "contains": {
                  "anyOf": [
                    {
                      "required": [
                        "price"
                      ]
                    },
                    {
                      "required": [
                        "compareAtPrice"
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "basic"
        ],
        "properties": {
          "basic": {
            "required": [
              "currency"
            ]
          }
        }
      }
    }
  ]
}
