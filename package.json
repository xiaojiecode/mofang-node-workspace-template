{
    "name": "mofang-node-workspace-template",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "init": "node tooling/cli.mjs init",
        "node:new": "node tooling/cli.mjs node:new",
        "dev": "vite --config playground/vite.config.mjs",
        "typecheck": "node tooling/cli.mjs typecheck",
        "build": "node tooling/cli.mjs build",
        "verify": "node tooling/cli.mjs verify",
        "test": "node --test tests/*.test.mjs",
        "test:cli": "node tooling/verify/cli.mjs",
        "test:browser": "node tooling/verify/browser.mjs",
        "verify:goja": "node tooling/verify/goja.mjs",
        "verify:runtime": "node tooling/verify/runtime.mjs",
        "verify:platform": "node tooling/verify/platform.mjs",
        "check": "npm run lint && npm run typecheck && npm run build && npm run verify && npm test && npm run test:cli && npm run test:browser && npm run verify:goja && npm run test:ui && npm run test:transitions",
        "sync:contracts": "node tooling/sync-contracts/index.mjs",
        "check:contracts": "node tooling/sync-contracts/index.mjs --check",
        "trial": "node tooling/cli.mjs trial",
        "format": "npm run lint:fix",
        "build:dev": "node tooling/cli.mjs build --development",
        "lint": "prettier --check lib nodes tooling playground tests shared *.json .prettierrc.json",
        "lint:fix": "prettier --write lib nodes tooling playground tests shared *.json .prettierrc.json",
        "platform": "node tooling/cli.mjs platform",
        "upstream": "node tooling/cli.mjs upstream",
        "test:ui": "node tooling/verify/ui.mjs",
        "test:transitions": "node tooling/verify/transitions.mjs",
        "dev:components": "vite --config playground/components/vite.config.mjs",
        "test:components": "node tooling/verify/components.mjs",
        "icons:optimize": "node tooling/icons/optimize.mjs",
        "icons:check": "node tooling/icons/optimize.mjs --check",
        "icons:verify": "node tooling/icons/verify.mjs",
        "test:gallery": "node tooling/verify/gallery.mjs",
        "test:reports": "node tooling/verify/reports.mjs",
        "test:popover-position": "node tooling/verify/popover-position.mjs"
    },
    "devDependencies": {
        "acorn": "8.15.0",
        "ajv": "8.17.1",
        "ajv-formats": "3.0.1",
        "esbuild": "0.28.2",
        "json-schema-to-typescript": "16.0.0",
        "lit": "3.3.3",
        "playwright": "1.57.0",
        "prettier": "3.8.0",
        "svgo": "4.1.0",
        "typescript": "7.0.2",
        "vite": "8.3.5"
    }
}
